exports[`gaugeToCode > prints the activity-ring template 1`] = `
"import {
  Gauge,
  GaugeArc,
  GaugeText,
  GaugeTrack,
  GaugeValue,
} from "@/components/gauge"

export function CustomGauge({ value }: { value: number }) {
  return (
    <Gauge
      value={value}
      min={0}
      max={600}
      startAngle={180}
      endAngle={540}
      radius={200}
      padding={56}
      transition={{ type: "spring", visualDuration: 0.5, bounce: 0.1 }}
    >
      <GaugeTrack
        width={44}
        color="var(--foreground)"
        opacity={0.12}
        cap="round"
        offset={0}
      />
      <GaugeArc
        width={44}
        color="var(--foreground)"
        opacity={1}
        cap="round"
        offset={0}
      />
      <GaugeValue
        x={0}
        y={-12}
        fontSize={80}
        color="var(--foreground)"
        font="rounded"
        weight="bold"
        decimals={0}
      />
      <GaugeText
        x={0}
        y={60}
        fontSize={24}
        color="var(--muted-foreground)"
        font="rounded"
        weight="medium"
      >
        kcal
      </GaugeText>
      <GaugeText
        x={0}
        y={-80}
        fontSize={22}
        color="var(--foreground)"
        font="rounded"
        weight="semibold"
      >
        Move
      </GaugeText>
    </Gauge>
  )
}"
`;

exports[`gaugeToCode > prints the air-quality template 1`] = `
"import {
  Gauge,
  GaugeArc,
  GaugeMarks,
  GaugeText,
  GaugeTrack,
  GaugeValue,
  GaugeZones,
  zoneCutoffs,
} from "@/components/gauge"

const zones = [
  { to: 50, color: "var(--muted)" },
  { to: 100, color: "var(--muted-foreground)" },
  { to: 500, color: "var(--foreground)" },
]

export function CustomGauge({ value }: { value: number }) {
  return (
    <Gauge
      value={value}
      min={0}
      max={500}
      startAngle={90}
      endAngle={270}
      radius={200}
      padding={56}
      fit="content"
      transition={{ type: "spring", visualDuration: 0.5, bounce: 0.1 }}
    >
      <GaugeTrack
        width={20}
        color="var(--muted)"
        opacity={1}
        cap="round"
        offset={0}
      />
      <GaugeZones
        zones={zones}
        width={6}
        offset={-22}
        gap={2}
        cap="butt"
        endCap="round"
        opacity={1}
      />
      <GaugeArc
        width={20}
        color="var(--foreground)"
        opacity={1}
        cap="round"
        offset={0}
      />
      <GaugeMarks
        values={zoneCutoffs(zones)}
        length={10}
        width={2}
        color="var(--foreground)"
        offset={-22}
        cap="round"
      />
      <GaugeValue
        x={0}
        y={-44}
        fontSize={84}
        color="var(--foreground)"
        font="rounded"
        weight="bold"
        decimals={0}
      />
      <GaugeText
        x={0}
        y={16}
        fontSize={24}
        color="var(--muted-foreground)"
        font="sans"
        weight="medium"
      >
        AQI
      </GaugeText>
      <GaugeText
        x={0}
        y={-124}
        fontSize={20}
        color="var(--muted-foreground)"
        font="sans"
        weight="medium"
      >
        Air quality
      </GaugeText>
    </Gauge>
  )
}"
`;

