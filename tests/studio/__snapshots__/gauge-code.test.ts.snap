exports[`gaugeToCode > prints the equaliser template 1`] = `
"import {
  GaugeTickFill,
  LinearGauge,
  LinearGaugeInset,
} from "@/components/gauge"

export function CustomGauge({
  value,
  sub,
  bass,
  lowMid,
  highMid,
  presence,
  air,
}: {
  value: number
  sub: number
  bass: number
  lowMid: number
  highMid: number
  presence: number
  air: number
}) {
  return (
    <LinearGauge
      value={value}
      min={-60}
      max={0}
      orientation="vertical"
      length={200}
      padding={{ top: 8, right: 176, bottom: 8, left: 176 }}
      transition={{ type: "spring", visualDuration: 0.5, bounce: 0.1 }}
    >
      <GaugeTickFill
        count={20}
        length={36}
        width={6}
        color="var(--foreground)"
        dimColor="var(--muted)"
        offset={0}
        cap="butt"
      />
      <LinearGaugeInset
        x={-150}
        y={0}
        scale={1}
        value={sub}
        min={-60}
        max={0}
        orientation="vertical"
        length={200}
        transition={{ type: "spring", visualDuration: 0.5, bounce: 0.1 }}
      >
        <GaugeTickFill
          count={20}
          length={36}
          width={6}
          color="var(--foreground)"
          dimColor="var(--muted)"
          offset={0}
          cap="butt"
        />
