exports[`gaugeToCode > prints the throttle template 1`] = `
"import {
  GaugeArc,
  GaugeMarks,
  GaugeText,
  GaugeTickLabels,
  GaugeTrack,
  GaugeValue,
  GaugeZones,
  LinearGauge,
  zoneCutoffs,
} from "@/components/gauge"

const zones = [
  { to: 25, color: "var(--muted)" },
  { to: 50, color: "var(--muted-foreground)" },
  { to: 75, color: "var(--foreground)" },
  { to: 100, color: "var(--primary)" },
]

export function CustomGauge({ value }: { value: number }) {
  return (
    <LinearGauge
      value={value}
      min={0}
      max={100}
      length={400}
      padding={{ top: 64, right: 28, bottom: 64, left: 28 }}
      transition={{ type: "spring", visualDuration: 0.5, bounce: 0.1 }}
    >
      <GaugeTrack
        width={28}
        color="var(--muted)"
        opacity={1}
        cap="butt"
        offset={0}
      />
      <GaugeZones
        zones={zones}
        width={8}
        offset={-24}
        gap={1.5}
        cap="butt"
        opacity={0}
      />
      <GaugeArc
        width={28}
        color="var(--foreground)"
        opacity={1}
        cap="butt"
        offset={0}
      />
      <GaugeMarks
        values={zoneCutoffs(zones)}
        length={28}
        width={4}
        color="var(--background)"
        offset={0}
        cap="butt"
      />
      <GaugeTickLabels
        count={4}
        offset={-36}
        fontSize={16}
        color="var(--muted-foreground)"
        font="sans"
        weight="medium"
        decimals={0}
      />
      <GaugeValue
        x={178}
        y={-44}
        fontSize={32}
        color="var(--foreground)"
        font="sans"
        weight="semibold"
        anchor="end"
        decimals={0}
      />
      <GaugeText
        x={200}
        y={-41}
        fontSize={22}
        color="var(--muted-foreground)"
        font="sans"
        weight="medium"
        anchor="end"
      >
        %
      </GaugeText>
      <GaugeText
        x={-200}
        y={-44}
        fontSize={22}
        color="var(--muted-foreground)"
        font="sans"
        weight="medium"
        anchor="start"
      >
        Throttle
      </GaugeText>
    </LinearGauge>
  )
}"
`;

