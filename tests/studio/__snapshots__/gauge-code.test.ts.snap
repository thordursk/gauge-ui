exports[`gaugeToCode > prints the tank template 1`] = `
"import {
  GaugeArc,
  GaugeMarks,
  GaugeText,
  GaugeTrack,
  GaugeValue,
  GaugeZones,
  LinearGauge,
  zoneCutoffs,
} from "@/components/gauge"

const zones = [
  { to: 25, color: "var(--muted)" },
  { to: 50, color: "var(--muted-foreground)" },
  { to: 75, color: "var(--foreground)" },
  { to: 100, color: "var(--primary)" },
]

export function CustomGauge({ value }: { value: number }) {
  return (
    <LinearGauge
      value={value}
      min={0}
      max={100}
      orientation="vertical"
      length={320}
      padding={{ top: 60, right: 44, bottom: 60, left: 44 }}
      transition={{ type: "spring", visualDuration: 0.5, bounce: 0.1 }}
    >
      <GaugeTrack
        width={64}
        color="var(--muted)"
        opacity={1}
        cap="butt"
        offset={0}
      />
      <GaugeZones
        zones={zones}
        width={8}
        offset={-24}
        gap={1.5}
        cap="butt"
        opacity={0}
      />
      <GaugeArc
        width={64}
        color="var(--foreground)"
        opacity={1}
        cap="butt"
        offset={0}
      />
      <GaugeMarks
        values={zoneCutoffs(zones)}
        length={64}
        width={4}
        color="var(--background)"
        offset={0}
        cap="butt"
      />
      <GaugeValue
